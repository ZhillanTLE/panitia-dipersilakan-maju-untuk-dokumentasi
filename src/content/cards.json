    {
      "id": "PAR-01",
      "version": 1,
      "level": "paragraf",
      "title": "Kebun Nenek",
      "layout": "prose",
      "blocks": [
        "Setiap hari Minggu, Dina pergi ke rumah nenek. Rumah nenek ada di dekat sawah. Di belakang rumah ada kebun kecil.",
        "Nenek menanam cabai, tomat, dan bayam. Dina senang membantu nenek menyiram tanaman. Sore hari, mereka makan pisang goreng bersama."
      ],
      "questions": [
        {
          "q": "Ke mana Dina pergi setiap hari Minggu?",
          "a": "Ke rumah nenek."
        },
        {
          "q": "Apa saja yang ditanam nenek?",
          "a": "Cabai, tomat, dan bayam."
        },
        {
          "q": "Apa yang mereka makan bersama pada sore hari?",
          "a": "Pisang goreng."
        }
      ]
    },
